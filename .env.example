# Copy this file to .env and fill in what you need. .env is never committed.
# The keys have no value; the place of the map has one, as an example.
#
#   cp .env.example .env
#
# Docker Compose reads .env by itself. With uv, pass it:
#
#   uv run --env-file .env --group vision python -m benchmarks.vision ask
#
# Nothing here is needed to use the library, the command line, the MCP server
# or the demo: the DPC data is open, with no account and no key.

# --- Where the data lives (optional) --------------------------------------
# The root shared with Limen and the other libraries of agent-engineering-studio:
# the data of this library goes to $DATA_ROOT/dpc-radar (the «Merging» frames
# in merging/, the IT-DPC-SRI history in it_dpc_sri/). Unset: ~/.cache/dpc-radar,
# and ./data/dpc-radar for Docker Compose and scripts/fetch-data.sh.
# DATA_ROOT=

# --- AI (optional) ---------------------------------------------------------
# The key of the Claude API (https://console.anthropic.com/). Only
# benchmarks/vision.py reads it today. Without it, nothing calls a model.
ANTHROPIC_API_KEY=

# --- The page of a municipality (optional) ---------------------------------
# Where the map opens, in decimal degrees: here Gioia del Colle, in Apulia, which
# is also where it opens with no coordinates at all. Write those of your place.
DPC_RADAR_LAT=40.7997
DPC_RADAR_LON=16.9236
# The zoom it opens at, 5 to 13 (default 11 with coordinates, 10 without).
DPC_RADAR_ZOOM=
# The name in the header and on the marker.
DPC_RADAR_PLACE="Comune di Gioia del Colle"
# What the map shows first: now, 1, 3, 6, 12 or 24 (hours). Default: now.
DPC_RADAR_LAYER=
# The tiles of the background map, and their credit (default: OpenStreetMap,
# which then sees the address of every visitor).
DPC_RADAR_TILES=
DPC_RADAR_TILES_CREDIT=

# --- The demo (optional: every one has a default) --------------------------
# The port of the page (default 3000).
DPC_RADAR_PORT=
# The port of the API behind the page, without Docker (default 8000).
DPC_RADAR_API_PORT=
# How many days of frames `make data` and `docker compose run --rm init` download (default 2).
DPC_RADAR_DAYS=
# Where the frames go, without Docker (default ./data).
DPC_RADAR_DATA=
